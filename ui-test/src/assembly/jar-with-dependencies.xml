<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <!-- Both src/main (config/Authorization/*.json etc., loaded from the classpath by name) and
         src/test (this suite's actual code) are needed at runtime — list both explicitly, or
         the fat jar silently drops src/main. -->
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.build.testOutputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <!-- Assembly plugin's "test" scope resolves the full compile+runtime+test graph —
                 everything this module and uitest-commons actually need at runtime. -->
            <scope>test</scope>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>true</unpack>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <!-- Only ever needed to satisfy a compile-time interface for sqlite-jdbc's
                     native-image module; no runtime use. -->
                <exclude>org.graalvm.nativeimage:svm</exclude>
            </excludes>
            <unpackOptions>
                <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>

    <!-- Two dependency jars each register their own TestEngine under the same
         META-INF/services file (Suite + Cucumber) — without this merge handler, unpacking
         overwrites one with the other and only one engine survives. -->
    <containerDescriptorHandlers>
        <containerDescriptorHandler>
            <handlerName>metaInf-services</handlerName>
        </containerDescriptorHandler>
    </containerDescriptorHandlers>
</assembly>
